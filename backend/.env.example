# Copy this file to .env and fill in the values. Never commit .env.
MONGO_DB_URL=mongodb+srv://<user>:<password>@<cluster>/zerodha
PORT=8080

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Landing site and dashboard URLs allowed to call the API (comma-separated)
CLIENT_URLS=http://localhost:5173,http://localhost:5174

# Accounts that sign up with these emails become admins (comma-separated)
ADMIN_EMAILS=admin@example.com
